{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "Allows the visible main window to use the minimum desktop authentication and secure-storage surface.",
  "identifier": "default",
  "permissions": [
    "allow-runtime-info",
    "allow-list-audio-devices",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://candorlens.vercel.app/*" },
        { "url": "http://localhost:3000/*" }
      ]
    },
    "stronghold:default"
  ],
  "windows": ["main"]
}
