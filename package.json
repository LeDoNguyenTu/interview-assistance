{
  "name": "candorlens",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "build": "turbo run build",
    "format:check": "prettier --check .",
    "ci:validate": "node scripts/validate-ci-workflows.mjs",
    "ci:validate:test": "node --test scripts/test/validate-ci-workflows.test.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "supabase": "2.113.0",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  }
}
